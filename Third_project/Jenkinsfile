pipeline {
    agent any
    stages {
        stage ('cloning'){ 
            steps {
            git branch: 'lakshman', url: 'https://github.com/lakshman-cpu/jenkins'

            }
        }
        stage('merge')
        {
            steps {
                sh ''' 
                git checkout -b lucky
                git config --global user.name "lakshman"
                git config --global user.email "lakshmankommineni1@gmail.com"
                git push origin lucky
                '''

            }
        }
    }
}
pipeline {
    agent any 

    stages {
        stage('clone'){
            steps {
            git branch: 'lakshman', url: 'https://github.com/lakshman-cpu/jenkins'
            }
        }

        stage('docker image'){
            agent {
                docker { image 'python3:latest'}
            }
            steps {
                sh '''python3 --version'''
            }
        }
    }
}